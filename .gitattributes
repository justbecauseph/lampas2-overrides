#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Preserve the exact deployed upstream bytes used by the Wilder Wild and Rogues SHA fixtures.
/src/test/resources/upstream/wilderwild/4.3.3/data/wilderwild/worldgen/configured_feature/stone_pool.json -text
/src/test/resources/upstream/rogues/3.1.3.003+26.2/data/minecraft/enchantment/sharpness.json -text
# Keep the Rogues replacement byte-identical to the SHA-256 recorded in docs/evidence/rogues-sharpness.json.
/src/main/resources/lampas2-overrides/resource-patches/rogues/3.1.3.003+26.2/data/minecraft/enchantment/sharpness.json -text
# RPG Series spell patches: fixtures are byte-exact jar entries (no trailing LF) and replacements match the
# SHA-256 values in docs/evidence/rpg-spell-patches.manifest.json, which keeps the plan's recorded bytes.
/src/test/resources/upstream/**/spell/**/*.json -text
/src/main/resources/lampas2-overrides/resource-patches/**/spell/**/*.json -text
/docs/evidence/rpg-spell-patches.manifest.json -text -whitespace
# Paladins and Rogues aeternium recipe patches: fixtures are byte-exact jar entries and replacements change only the
# stick key, so both keep the jars' LF line endings.
/src/test/resources/upstream/**/recipe/*.json -text
/src/main/resources/lampas2-overrides/resource-patches/**/recipe/*.json -text
# Structory: Towers, Dungeons and Taverns and Trek waystone template pools: fixtures are byte-exact jar entries
# (Dungeons and Taverns and Trek ship CRLF) and replacements are the upstream pool with an empty element (Trek: a repointed location), in LF.
/src/test/resources/upstream/**/template_pool/**/*.json -text
/src/main/resources/lampas2-overrides/resource-patches/**/template_pool/**/*.json -text
# Trek village plaza templates: Waystones 26.2.0.13 village templates with the two waystone blocks set to air.
/src/main/resources/data/lampas/structure/**/*.nbt binary
/src/test/resources/upstream/waystones/**/*.nbt binary
