{
	"schemaVersion": 1,
	"id": "lampas2-overrides",
	"version": "${version}",
	"name": "Lampas2 Overrides",
	"description": "Compatibility fixes for Figura, ReplayMod, Chatting, Lootr, Fast Item Frames, Better Lib, Underground Village, Additional Lanterns, Mob Filter, Incendium, Visual Workbench, Name Tag Upgrade, Gravestones, Jade and Custom Name.",
	"authors": [
		"justbecauseph"
	],
	"contact": {
		"homepage": "https://github.com/justbecauseph/lampas2-overrides",
		"sources": "https://github.com/justbecauseph/lampas2-overrides",
		"issues": "https://github.com/justbecauseph/lampas2-overrides/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/lampas2-overrides/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"lampas2overrides.protocol.LampasProtocolServer",
			"lampas2overrides.incendium.IncendiumOptimization",
			"lampas2overrides.stoneholm.StoneholmDataFixes"
		],
		"client": [
			"lampas2overrides.client.Lampas2OverridesClient",
			"lampas2overrides.client.protocol.LampasProtocolClient"
		]
	},
	"mixins": [
		{
			"config": "lampas2-overrides.figurareplay.mixins.json",
			"environment": "client"
		},
		{
			"config": "lampas2-overrides.chatheads.mixins.json",
			"environment": "client"
		},
		{
			"config": "lampas2-overrides.visualworkbench.mixins.json",
			"environment": "client"
		},
		{
			"config": "lampas2-overrides.nametagupgrade.mixins.json",
			"environment": "client"
		},
		{
			"config": "lampas2-overrides.gravestones.mixins.json",
			"environment": "client"
		},
		{
			"config": "lampas2-overrides.jadenameplates.mixins.json",
			"environment": "client"
		},
		{
			"config": "lampas2-overrides.jadecustomname.mixins.json",
			"environment": "client"
		},
		{
			"config": "lampas2-overrides.lootrfastframes.mixins.json"
		},
		{
			"config": "lampas2-overrides.betterlib.mixins.json"
		},
		{
			"config": "lampas2-overrides.stoneholm.mixins.json"
		},
		{
			"config": "lampas2-overrides.additionallanterns.mixins.json"
		},
		{
			"config": "lampas2-overrides.customname.mixins.json"
		},
		{
			"config": "lampas2-overrides.mobfilter.mixins.json"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25"
	},
	"suggests": {
		"lootr": "*",
		"fastitemframes": "*",
		"better_lib": "*",
		"underground_village": "*",
		"additionallanterns": "*",
		"incendium": "=5.5.0",
		"visualworkbench": "*",
		"nametagupgrade": "*",
		"gravestones": "*",
		"jade": "*",
		"eclipsescustomname": "*",
		"mobfilter": "*"
	}
}
